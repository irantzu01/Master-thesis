+def load_local_model(model_path: str, tokenizer_name: str, no_cache=False, **kwargs):
+    """
+    Load a local model checkpoint but use a HuggingFace hub tokenizer.
+    """
+    model = None
+    tokenizer = None
+
+    # Strip out revision_step from kwargs if it got passed along, 
+    # since local checkpoints don't use HF branches/commits
+    kwargs.pop('revision_step', None)
+    revision_step = "main"
+
+    try:
+        if no_cache:
+            with tempfile.TemporaryDirectory() as tmpdirname:
+                # Load weights from the local directory
+                model = AutoModelForCausalLM.from_pretrained(
+                    model_path,
+                    cache_dir=tmpdirname,
+                    **kwargs
+                )
+                # Load tokenizer from the HuggingFace Hub name
+                tokenizer = AutoTokenizer.from_pretrained(
+                    tokenizer_name,
+                    cache_dir=tmpdirname,
+                    revision=revision_step,
+                    **kwargs
+                )
+        else:
+            # Load weights from the local directory
+            model = AutoModelForCausalLM.from_pretrained(
+                model_path,
+                **kwargs
+            )
+            # Load tokenizer from the HuggingFace Hub name
+            tokenizer = AutoTokenizer.from_pretrained(
+                tokenizer_name,
+                revision=revision_step,
+                **kwargs
+            )
+    except OSError as e:
+        print(f"Failed to load local model from '{model_path}' or tokenizer '{tokenizer_name}'")
+        print(f"Error: {e}")
+        return None
+
+    if model is None or tokenizer is None:
+        print(f"Model or tokenizer not loaded properly for local execution.")
+        return None
+
+    print(f"Successfully loaded local model weights from '{model_path}' using tokenizer '{tokenizer_name}'")
+
+    # Set up the execution device
+    device = 'cpu'
+    if torch.cuda.is_available():
+        device = 'cuda'
+    elif torch.backends.mps.is_available():
+        device = 'mps'
+        
+    # Wrap them up exactly how multiblimp expects it
+    ilm_model = scorer.IncrementalLMScorer(
+        model,
+        device=device,
+        tokenizer=tokenizer,
+    )
+
+    return ilm_model
